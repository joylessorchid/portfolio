---
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import type { Shot } from '../data/projects';
import { useUi, type Lang } from '../i18n/ui';

interface Props {
  shots: Shot[];
  lang: Lang;
}
const { shots, lang } = Astro.props;
const t = useUi(lang);

// Полноразмерная версия для лайтбокса (она же — ссылка, если JS не загрузился).
const items = await Promise.all(
  shots.map(async (s) => ({
    shot: s,
    full: await getImage({ src: s.src, quality: 88 }),
  })),
);
const phones = shots.length > 0 && shots.every((s) => s.device === 'phone');
---

<div class:list={['carousel', 'reveal', { phones }]} data-gallery>
  <div class="track" data-track tabindex="0" role="group" aria-label={t.project.screens}>
    {
      items.map(({ shot, full }) => (
        <figure class="slide">
          <a
            class="zoom"
            href={full.src}
            data-lightbox
            data-caption={shot.alt[lang]}
            data-w={full.attributes.width}
            data-h={full.attributes.height}
            aria-label={`${t.project.openImage}: ${shot.alt[lang]}`}
          >
            <Image
              src={shot.src}
              alt={shot.alt[lang]}
              widths={phones ? [320, 480, 640] : [640, 960, 1280, 1600, 1920]}
              sizes={phones ? '(min-width: 622px) 280px, 45vw' : '(min-width: 1024px) 880px, 86vw'}
              quality={84}
            />
            <span class="hint" aria-hidden="true"><Icon name="expand" size={16} /></span>
          </a>
          <figcaption>{shot.alt[lang]}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="bar">
    <p class="count mono"><span data-count>1</span> {t.project.of} {items.length}</p>
    <div class="navs">
      <button class="nav" type="button" data-prev aria-label="←"><Icon name="arrow-left" /></button>
      <button class="nav" type="button" data-next aria-label="→"><Icon name="arrow-right" /></button>
    </div>
  </div>
</div>

<dialog class="lightbox" data-lightbox-dialog aria-label={t.project.screens}>
  <button class="lb-close" type="button" data-lb-close aria-label={t.close}><Icon name="x" /></button>
  <button class="lb-nav prev" type="button" data-lb-prev aria-label="←"><Icon name="arrow-left" /></button>
  <img alt="" data-lb-img />
  <button class="lb-nav next" type="button" data-lb-next aria-label="→"><Icon name="arrow-right" /></button>
  <p class="lb-caption" data-lb-caption></p>
</dialog>

<script>
  // Карусель: пролистывание мышью, пальцем, стрелками и кнопками; снап по кадрам.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const count = root.querySelector<HTMLElement>('[data-count]');
    if (!track || !prev || !next || !count || !slides.length) return;

    const current = () => {
      const left = track.getBoundingClientRect().left + parseFloat(getComputedStyle(track).paddingLeft);
      let best = 0;
      let dist = Infinity;
      slides.forEach((s, i) => {
        const d = Math.abs(s.getBoundingClientRect().left - left);
        if (d < dist) {
          dist = d;
          best = i;
        }
      });
      return best;
    };
    const sync = () => {
      count.textContent = String(current() + 1);
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    };
    const go = (i: number) =>
      slides[Math.max(0, Math.min(slides.length - 1, i))].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });

    // Кадры за краем экрана браузер откладывает (по горизонтали он их «не видит»), и при
    // пролистывании слайд оказывался пустым. Как только карусель подходит к экрану — грузим все.
    new IntersectionObserver((entries, obs) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      root.querySelectorAll('img').forEach((im) => (im.loading = 'eager'));
      obs.disconnect();
    }, { rootMargin: '300px' }).observe(root);

    prev.addEventListener('click', () => go(current() - 1));
    next.addEventListener('click', () => go(current() + 1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    addEventListener('resize', sync);
    sync();

    // Протаскивание мышью, как в лендингах; на тач-экранах работает родная прокрутка.
    let dragging = false;
    let startX = 0;
    let startLeft = 0;
    let moved = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startLeft = track.scrollLeft;
      track.classList.add('dragging');
    });
    addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      if (moved > 4) track.scrollLeft = startLeft - dx;
    });
    addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('dragging');
      if (moved > 4) go(current()); // доводим до ближайшего кадра
    });
    track.addEventListener('click', (e) => moved > 6 && e.preventDefault(), true);
  });
</script>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]'));
  if (dialog && links.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-caption]')!;
    let current = 0;
    const show = (i: number) => {
      current = (i + links.length) % links.length;
      const a = links[current];
      const thumb = a.querySelector('img');
      img.alt = a.dataset.caption ?? '';
      img.width = Number(a.dataset.w);
      img.height = Number(a.dataset.h);
      caption.textContent = a.dataset.caption ?? '';
      // Сначала — уже загруженный кадр из карусели: иначе долю секунды видно прошлую картинку,
      // пока грузится полноразмерная. Подменяем, только когда она декодирована.
      img.src = thumb?.currentSrc || a.href;
      if (img.src !== a.href) {
        const full = new Image();
        full.src = a.href;
        const swap = () => links[current] === a && (img.src = a.href);
        full.decode ? full.decode().then(swap, swap) : full.addEventListener('load', swap);
      }
    };
    links.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-lb-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    if (links.length < 2) dialog.querySelectorAll<HTMLElement>('.lb-nav').forEach((b) => (b.hidden = true));
  }
</script>

<style>
  .carousel {
    display: grid;
    gap: 16px;
  }
  .track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  .track:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: var(--radius);
  }
  .slide {
    flex: 0 0 auto;
    width: min(86vw, 880px);
    display: grid;
    gap: 10px;
    margin: 0;
    scroll-snap-align: start;
  }
  .phones .slide {
    width: min(45vw, 280px);
  }
  .zoom {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--bg-sunk);
    cursor: zoom-in;
  }
  .zoom :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: scale 0.5s var(--ease);
    -webkit-user-drag: none;
  }
  .zoom:hover :global(img) {
    scale: 1.015;
  }
  .phones .zoom {
    border-radius: 24px;
  }
  .hint {
    position: absolute;
    right: 12px;
    top: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 0.2s;
  }
  .zoom:hover .hint,
  .zoom:focus-visible .hint {
    opacity: 1;
  }
  figcaption {
    color: var(--ink-3);
    font-size: 14px;
    line-height: 1.45;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .count {
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .navs {
    display: flex;
    gap: 8px;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--line-2);
    transition: background-color 0.2s, opacity 0.2s, border-color 0.2s;
  }
  .nav:hover:not(:disabled) {
    background: var(--paper-3);
  }
  .nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* на телефоне кадры выходят за поля — видно, что список листается */
  @media (max-width: 767px) {
    .track {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 56px 16px 72px;
    border: 0;
    background: rgb(8 8 10 / 0.94);
    color: #f2f2f3;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: transparent;
  }
  .lightbox img {
    max-width: min(100%, 1800px);
    max-height: calc(100dvh - 140px);
    width: auto;
    height: auto;
    border-radius: 12px;
    object-fit: contain;
  }
  .lb-caption {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 24px;
    text-align: center;
    color: #b4b4bc;
    font-size: 14px;
  }
  .lb-close,
  .lb-nav {
    position: absolute;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: #f2f2f3;
    background: rgb(255 255 255 / 0.08);
    border: 1px solid rgb(255 255 255 / 0.14);
    transition: background-color 0.2s;
  }
  .lb-close:hover,
  .lb-nav:hover {
    background: rgb(255 255 255 / 0.16);
  }
  .lb-close {
    top: 12px;
    right: 12px;
  }
  .lb-nav {
    top: 50%;
    translate: 0 -50%;
  }
  .prev {
    left: 12px;
  }
  .next {
    right: 12px;
  }
</style>
