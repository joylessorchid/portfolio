---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const L = {
  ru: {
    router: 'Роутер · проброс 443',
    proxy: 'reverse proxy · TLS',
    host: 'Proxmox VE 9 · мини-ПК · 10 LXC + 2 VM',
    groups: ['Приложения', 'Данные', 'Наблюдаемость', 'Сеть'],
    backups: 'ZFS-снапшоты и автобэкапы',
    alerts: 'Алерты в Telegram',
    shared: 'общая',
  },
  en: {
    router: 'Router · port 443 forward',
    proxy: 'reverse proxy · TLS',
    host: 'Proxmox VE 9 · mini-PC · 10 LXC + 2 VM',
    groups: ['Apps', 'Data', 'Observability', 'Network'],
    backups: 'ZFS snapshots & automated backups',
    alerts: 'Telegram alerts',
    shared: 'shared',
  },
}[lang];

const groups = [
  ['Gitea', 'n8n', 'Homepage', 'TeamSpeak', 'Frappe LMS · VM', 'k3s · VM'],
  [`PostgreSQL · ${L.shared}`],
  ['Prometheus', 'pve-exporter', 'Grafana'],
  ['Technitium DNS'],
];
---

<figure class="map">
  <div class="edge">
    <p class="node">Cloudflare DNS</p>
    <span class="arrow" aria-hidden="true"></span>
    <p class="node">{L.router}</p>
    <span class="arrow" aria-hidden="true"></span>
    <p class="node strong">NPMplus <span>{L.proxy}</span></p>
  </div>
  <div class="host">
    <p class="host-label">{L.host}</p>
    <div class="groups">
      {
        groups.map((items, i) => (
          <div class="group">
            <p class="g-title">{L.groups[i]}</p>
            <ul>
              {items.map((it) => (
                <li>{it}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="foot">
      <span>{L.backups}</span>
      <span>{L.alerts}</span>
    </div>
  </div>
</figure>

<style>
  .map {
    display: grid;
    gap: 14px;
    font-size: 14px;
  }
  .edge {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .node {
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    font-weight: 560;
  }
  .node span {
    display: block;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 400;
    color: var(--ink-3);
  }
  .node.strong {
    border-color: color-mix(in oklab, var(--tint-ink) 50%, transparent);
    background: color-mix(in oklab, var(--tint) 60%, var(--bg-elev));
  }
  .arrow {
    width: 22px;
    height: 1px;
    background: var(--line-2);
    position: relative;
  }
  .arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    border: 3.5px solid transparent;
    border-left: 5px solid var(--line-2);
    border-right: 0;
  }
  .host {
    display: grid;
    gap: 14px;
    padding: 18px;
    border-radius: 18px;
    border: 1px dashed color-mix(in oklab, var(--tint-ink) 45%, transparent);
    background: color-mix(in oklab, var(--tint) 35%, transparent);
  }
  .host-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--tint-ink);
  }
  .groups {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }
  .group {
    padding: 14px;
    border-radius: 14px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
  }
  .g-title {
    margin-bottom: 8px;
    font-weight: 600;
  }
  .group ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .group li {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 3px 8px;
    border-radius: 7px;
    background: var(--bg-sunk);
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .foot span {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
  }
</style>
