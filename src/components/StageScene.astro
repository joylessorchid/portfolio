---
import BrowserFrame from './BrowserFrame.astro';
import PhoneFrame from './PhoneFrame.astro';
import DiagnosticFlow from './diagrams/DiagnosticFlow.astro';
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  /** explorer — витрина на главной, hero — шапка кейса, card — карточка на телефоне и «следующий кейс» */
  variant: 'explorer' | 'hero' | 'card';
  eager?: boolean;
}

const { project: p, lang, variant, eager = false } = Astro.props;
const c = p.cover;
// sizes — реальная ширина окна/телефона в сцене (см. стили ниже), иначе браузер берёт слишком мелкий файл
const frameSizes = {
  explorer: '(min-width: 1440px) 640px, (min-width: 960px) 45vw, 90vw',
  hero: '(min-width: 1440px) 1130px, (min-width: 960px) 80vw, (min-width: 640px) 90vw, 130vw',
  card: '640px',
}[variant];
const phoneSizes = {
  explorer: '(min-width: 1440px) 210px, 15vw',
  hero: '(min-width: 1440px) 380px, 27vw',
  card: '(min-width: 560px) 180px, 120px',
}[variant];
---

<div class:list={['scene', `scene-${c.kind}`, `v-${variant}`]}>
  {c.kind === 'frame' && <BrowserFrame shot={c.shot} lang={lang} class="frame" sizes={frameSizes} eager={eager} />}
  {
    c.kind === 'phones' && (
      <div class="phones">
        {c.shots.map((s, i) => (
          <PhoneFrame shot={s} lang={lang} class={`p p${i}`} sizes={phoneSizes} eager={eager} />
        ))}
      </div>
    )
  }
  {c.kind === 'diagram' && <DiagnosticFlow lang={lang} compact />}
  {
    c.kind === 'numbers' && (
      <ul class="numbers">
        {c.items.map((n) => (
          <li>
            <span class="display">{n.value}</span>
            <span class="label">{n.label[lang]}</span>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  /* Сцена сама задаёт себе контейнер (container: stage / size) в родителе — здесь все размеры
     считаются от неё (cqw/cqh), а не от окна браузера. */
  .scene {
    position: absolute;
    inset: 0;
  }

  /* Окно браузера всегда уходит за правый и нижний край сцены: ширина — не меньше 88% сцены
     и не меньше той, при которой окно (скриншоты ~2:1 + панель 26px) достаёт до низа. */
  .scene :global(.frame) {
    position: absolute;
    left: 6%;
    top: 9%;
    width: max(88%, calc((94cqh - 26px) / 0.494));
  }
  /* В маленькой карточке окно крупнее карточки: видно левый верхний угол интерфейса */
  .v-card :global(.frame) {
    left: 24px;
    top: 24px;
    width: max(560px, calc(100% + 40px), calc((94cqh - 26px) / 0.494));
    border-radius: 10px 0 0 0;
  }

  /* Три телефона веером: крепятся к верху сцены, низ обрезается краем сцены */
  .phones {
    position: absolute;
    inset: 0;
  }
  .phones :global(.p) {
    position: absolute;
    width: 27%;
    top: 22%;
  }
  .phones :global(.p0) {
    left: 8%;
  }
  .phones :global(.p1) {
    left: 35.5%;
    width: 29%;
    top: 7%;
    z-index: 1;
  }
  .phones :global(.p2) {
    right: 8%;
  }
  .v-card .phones :global(.p) {
    width: 30%;
    top: 24%;
  }
  .v-card .phones :global(.p0) {
    left: 5%;
  }
  .v-card .phones :global(.p1) {
    left: 34%;
    width: 32%;
    top: 8%;
  }
  .v-card .phones :global(.p2) {
    right: 5%;
  }

  /* Цифры: на просторной сцене — три колонки, на узкой или низкой — список «число — подпись» */
  .numbers {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-content: center;
    gap: 24px;
    padding: 0 8%;
  }
  .numbers li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding-top: 22px;
    border-top: 1px solid rgb(241 237 230 / 0.2);
  }
  .numbers .display {
    font-size: clamp(2.6rem, 11cqw, 6.5rem);
    line-height: 1;
  }
  .numbers .label {
    font-size: 14px;
    line-height: 1.45;
    color: var(--night-fg-2);
  }
  @container stage (max-width: 560px) or (max-height: 300px) {
    .numbers {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding: 0 7%;
    }
    .numbers li {
      grid-template-columns: 3.2rem minmax(0, 1fr);
      align-items: center;
      gap: 14px;
      padding-top: 8px;
    }
    .numbers .display {
      font-size: 2rem;
    }
    .numbers .label {
      font-size: 12.5px;
      line-height: 1.4;
    }
  }
  @container stage (max-height: 239px) {
    .numbers li {
      padding-top: 6px;
    }
    .numbers .display {
      font-size: 1.75rem;
    }
    .numbers .label {
      font-size: 12px;
      line-height: 1.35;
    }
  }
</style>
