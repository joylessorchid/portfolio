---
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

type Zone = 'ru' | 'ext';
const steps: { tag: string; title: Record<Lang, string>; detail: Record<Lang, string>; zone: Zone; data: Record<Lang, string> }[] = [
  {
    tag: 'SIP / WebRTC',
    title: { ru: 'Звонок', en: 'Call' },
    detail: { ru: 'исходящий вызов по базе контактов', en: 'outbound call from a contact list' },
    zone: 'ru',
    data: { ru: 'аудио', en: 'audio' },
  },
  {
    tag: 'LiveKit · self-hosted',
    title: { ru: 'Медиасервер', en: 'Media server' },
    detail: { ru: 'Silero VAD и русский turn detector', en: 'Silero VAD and a Russian turn detector' },
    zone: 'ru',
    data: { ru: 'аудио', en: 'audio' },
  },
  {
    tag: 'Yandex SpeechKit v3',
    title: { ru: 'Распознавание речи', en: 'Speech-to-text' },
    detail: { ru: 'напрямую из РФ', en: 'directly from Russia' },
    zone: 'ru',
    data: { ru: 'аудио → текст', en: 'audio → text' },
  },
  {
    tag: 'LLM-адаптер',
    title: { ru: 'Ответ агента', en: 'Agent reply' },
    detail: { ru: 'шлюз V2Horizon → Gemini, YandexGPT или OpenRouter', en: 'V2Horizon gateway → Gemini, YandexGPT or OpenRouter' },
    zone: 'ext',
    data: { ru: 'текст', en: 'text' },
  },
  {
    tag: 'Normalizer',
    title: { ru: 'Нормализация', en: 'Normalisation' },
    detail: { ru: 'числа и ударения перед синтезом', en: 'numbers and stress marks before synthesis' },
    zone: 'ru',
    data: { ru: 'текст', en: 'text' },
  },
  {
    tag: 'ElevenLabs',
    title: { ru: 'Синтез речи', en: 'Text-to-speech' },
    detail: { ru: 'Flash v2.5 или v3 + дисковый кэш фраз', en: 'Flash v2.5 or v3 + on-disk phrase cache' },
    zone: 'ext',
    data: { ru: 'текст → аудио', en: 'text → audio' },
  },
];

const legend = {
  ru: { ru: 'Аудио и записи — в РФ', ext: 'Внешние API — только текст', loop: 'Ответ возвращается в звонок через LiveKit' },
  en: { ru: 'Audio and recordings stay in Russia', ext: 'External APIs see text only', loop: 'The reply streams back into the call via LiveKit' },
}[lang];
---

<figure class="pipeline">
  <ol>
    {
      steps.map((s, i) => (
        <li class:list={['node', s.zone]}>
          <p class="top">
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="data">{s.data[lang]}</span>
          </p>
          <p class="title">{s.title[lang]}</p>
          <p class="tech">{s.tag === 'LLM-адаптер' && lang === 'en' ? 'LLM adapter' : s.tag}</p>
          <p class="detail">{s.detail[lang]}</p>
        </li>
      ))
    }
  </ol>
  <figcaption>
    <span class="key ru"><i></i>{legend.ru}</span>
    <span class="key ext"><i></i>{legend.ext}</span>
    <span class="loop">↺ {legend.loop}</span>
  </figcaption>
</figure>

<style>
  .pipeline {
    display: grid;
    gap: 16px;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
  }
  .node {
    display: grid;
    gap: 4px;
    align-content: start;
    padding: 16px 18px 18px;
    border-radius: 16px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
  }
  .node.ru {
    border-color: color-mix(in oklab, var(--tint-ink) 45%, transparent);
    background: color-mix(in oklab, var(--tint) 55%, var(--bg-elev));
  }
  .node.ext {
    border-style: dashed;
    border-color: var(--line-2);
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .n {
    color: var(--tint-ink);
  }
  .data {
    padding: 2px 8px;
    border-radius: 999px;
    color: var(--ink-3);
    border: 1px solid var(--line);
    text-transform: none;
    letter-spacing: 0;
  }
  .title {
    font-weight: 620;
    font-size: 17px;
    letter-spacing: -0.015em;
  }
  .tech {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--tint-ink);
  }
  .detail {
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.45;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .key i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
  }
  .key.ru i {
    background: color-mix(in oklab, var(--tint) 55%, var(--bg-elev));
    border: 1px solid color-mix(in oklab, var(--tint-ink) 45%, transparent);
  }
  .key.ext i {
    border: 1px dashed var(--line-2);
  }
  .loop {
    color: var(--ink-3);
  }
</style>
