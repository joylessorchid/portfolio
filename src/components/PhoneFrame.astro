---
import { Image } from 'astro:assets';
import type { Shot } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  shot: Shot;
  lang: Lang;
  class?: string;
  sizes?: string;
  eager?: boolean;
}

const { shot, lang, class: className, sizes = '(min-width: 960px) 220px, 32vw', eager = false } = Astro.props;
---

<div class:list={['phone', className]}>
  <Image
    src={shot.src}
    alt={shot.alt[lang]}
    widths={[240, 360, 480, 720]}
    sizes={sizes}
    quality={84}
    loading={eager ? 'eager' : 'lazy'}
  />
</div>

<style>
  .phone {
    padding: 5px;
    border-radius: 30px;
    background: #0c0c0f;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      var(--shadow-lg);
  }
  .phone :global(img) {
    width: 100%;
    height: auto;
    border-radius: 25px;
  }
</style>
