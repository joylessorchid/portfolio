---
// Служебная страница 1200×630: скрипт export делает из неё OG-картинку для соцсетей.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import photo from '../assets/photo.jpg';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const tags = {
  ru: ['Голосовые AI-агенты', 'Интернет-магазины', 'n8n', 'DevOps'],
  en: ['Voice AI agents', 'Online stores', 'n8n', 'DevOps'],
}[lang];
---

<Base lang={lang} title="OG" description="" path={`/og/${lang}/`} bare noindex alternates={false}>
  <div class="og">
    <div class="text">
      <p class="eyebrow"><span class="dot dot-live"></span>{profile.availability[lang]}</p>
      <h1 class="name">
        <span class="first">{profile.firstName[lang]}</span>
        <span class="last display">{profile.lastName[lang]}</span>
      </h1>
      <p class="role">{profile.role[lang]}</p>
      <ul class="tags">{tags.map((t) => <li>{t}</li>)}</ul>
      <p class="site mono">v2horizon.com</p>
    </div>
    <div class="photo">
      <Image src={photo} alt="" width={900} height={900} quality={86} loading="eager" />
    </div>
  </div>
</Base>

<style>
  :global(body) {
    margin: 0;
    background: var(--paper);
  }
  .og {
    position: relative;
    width: 1200px;
    height: 630px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 440px;
    background: var(--paper);
    color: var(--ink);
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    padding: 60px 0 52px 72px;
  }
  .name {
    display: flex;
    flex-direction: column;
    line-height: 0.86;
    margin-top: 4px;
  }
  .first {
    font-weight: 800;
    font-size: 88px;
    letter-spacing: -0.065em;
    text-transform: uppercase;
  }
  .last {
    font-size: 112px;
    letter-spacing: -0.03em;
    color: var(--accent);
    margin-top: 4px;
  }
  .role {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags li {
    padding: 6px 14px;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    font-size: 18px;
    font-weight: 500;
  }
  .site {
    margin-top: auto;
    font-size: 20px;
    color: var(--ink-2);
  }
  .photo {
    display: flex;
    align-items: stretch;
  }
  .photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    mix-blend-mode: multiply;
    filter: contrast(1.05) saturate(0.85);
  }
</style>
